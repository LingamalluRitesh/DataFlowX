# ==============================================================================
# DataFlowX Platform Configuration
# ==============================================================================

# Environment: development, staging, production
ENVIRONMENT=development
DEBUG=true
APP_NAME=DataFlowX
APP_VERSION=1.0.0
SECRET_KEY=change-this-to-a-secure-random-32-byte-hex-string-for-production
ENCRYPTION_MASTER_KEY=k8A3VbE2QpY0zW1mN4xL7sJ5hF9cT6rU4dG1vK8wP2o=

# Backend API Configuration
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
API_V1_STR=/api/v1
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://127.0.0.1:3000","http://127.0.0.1:8000"]
ALLOWED_HOSTS=["*"]

# Security & Tokens
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7
ALGORITHM=HS256

# Primary PostgreSQL Database (Metadata)
POSTGRES_SERVER=localhost
POSTGRES_PORT=5432
POSTGRES_USER=dataflowx
POSTGRES_PASSWORD=dataflowx_secure_password
POSTGRES_DB=dataflowx_metadata
DATABASE_URL=postgresql+asyncpg://dataflowx:dataflowx_secure_password@localhost:5432/dataflowx_metadata
SYNC_DATABASE_URL=postgresql+psycopg2://dataflowx:dataflowx_secure_password@localhost:5432/dataflowx_metadata

# Redis Configuration (Cache, Locks & Celery Broker)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://localhost:6379/0

# Celery Distributed Task Queue
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2
CELERY_TASK_DEFAULT_QUEUE=default
CELERY_TASK_HIGH_QUEUE=high_priority
CELERY_TASK_LOW_QUEUE=low_priority

# Medallion Lake Object Storage (MinIO / S3)
STORAGE_TYPE=local # 'local' or 's3' or 'minio'
LOCAL_STORAGE_BASE_PATH=./storage
S3_ENDPOINT_URL=http://localhost:9000
S3_ACCESS_KEY_ID=minioadmin
S3_SECRET_ACCESS_KEY=minioadmin
S3_BUCKET_NAME=dataflowx-lake
S3_REGION=us-east-1
S3_SECURE=false

# Analytical Data Warehouse
WAREHOUSE_TYPE=postgres # 'postgres' or 'duckdb' or 'clickhouse'
WAREHOUSE_DATABASE_URL=postgresql+psycopg2://dataflowx:dataflowx_secure_password@localhost:5432/dataflowx_warehouse
WAREHOUSE_DUCKDB_PATH=./storage/warehouse/analytics.duckdb

# Prometheus & Metrics
ENABLE_METRICS=true
METRICS_PORT=9090

# Alerting & Notifications
SMTP_HOST=smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=alerts@dataflowx.io
SLACK_WEBHOOK_URL=
DEFAULT_ALERT_WEBHOOK=

# Super Admin Initial Bootstrapping
INITIAL_ADMIN_EMAIL=admin@dataflowx.io
INITIAL_ADMIN_PASSWORD=Admin@DataFlowX2026!
INITIAL_ADMIN_FULL_NAME=System Super Administrator
INITIAL_ORG_NAME=Global Enterprise Corp
INITIAL_WORKSPACE_NAME=Production Analytics

# Frontend Environment (Next.js)
NEXT_PUBLIC_API_URL=http://localhost:8000/api/v1
NEXT_PUBLIC_APP_NAME=DataFlowX
NEXT_PUBLIC_ENABLE_ANALYTICS=true
